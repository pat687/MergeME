# Copy to .env (or run `make init`, which also fills in random secrets).
# Values written as __RANDOM__ are replaced with a fresh random string by `make init`.

# --- Lead router --------------------------------------------------------------
ROUTER_ADMIN_API_KEY=__RANDOM__
ROUTER_LINK_SIGNING_SECRET=__RANDOM__
ROUTER_DB_PASSWORD=__RANDOM__
ROUTER_HTTP_PORT=8000
# Links in emails point here. Follows ROUTER_HTTP_PORT unless you set a real domain.
ROUTER_PUBLIC_BASE_URL=http://localhost:${ROUTER_HTTP_PORT}
# true = admin API shows clickable attorney offer links (handy for demos, never in production)
ROUTER_DEMO_MODE=true

# --- Where leads may be sold: READ BEFORE REAL USE --------------------------------
# DEMO VALUES. The demo attorneys are fictional and in Illinois. Before real use, replace
# these with the states (and the flagged practice areas) a lawyer licensed there has
# approved in writing: see docs/COMPLIANCE.md and the counsel brief. Empty ROUTER_LAUNCH_STATES means
# no inquiry is accepted anywhere. ROUTER_COUNSEL_CLEARED records that approval for the
# risks listed in app/domain/compliance.py (RESTRICTIONS); Illinois injury areas are on it.
ROUTER_LAUNCH_STATES='["IL"]'
ROUTER_COUNSEL_CLEARED='["IL:personal_injury","IL:medical_malpractice","IL:workers_comp"]'
# Where counsel's written approval for those clearances is filed. Production refuses
# ROUTER_COUNSEL_CLEARED without it, so the demo values above can't slip into real use.
ROUTER_COUNSEL_APPROVAL_REF=
# Extra blocks, e.g. '{"NY": ["immigration"], "OR": ["*"]}' [none]
ROUTER_BLOCKED_AREAS_BY_STATE=
# Bar-license checks: attorneys get leads only if staff recorded one within
# ROUTER_LICENSE_RECHECK_DAYS [90]. Off only for the demo; production refuses false.
ROUTER_REQUIRE_LICENSE_VERIFICATION=false
ROUTER_LICENSE_RECHECK_DAYS=
# Once set, attorneys need to have accepted this participation agreement version [none]
ROUTER_ATTORNEY_AGREEMENT_VERSION=
# The business behind the platform, shown in the disclosure, privacy policy and emails.
# Required when ROUTER_DEMO_MODE=false.
ROUTER_LEGAL_ENTITY_NAME=
ROUTER_POSTAL_ADDRESS=
# Where people send privacy requests [info@legalleadrouter.com]
ROUTER_PRIVACY_EMAIL=
# Per state, the responsible attorney line counsel wants in advertising [none]
ROUTER_RESPONSIBLE_ATTORNEYS=
# Days before personal details are erased automatically (legal holds pause it):
# rejected [30], never sold [90], story of sold leads [90], consent evidence of sold
# leads [1916, about 5 years 3 months], bodies of sent emails [14]
ROUTER_RETENTION_REJECTED_DAYS=
ROUTER_RETENTION_UNROUTED_DAYS=
ROUTER_RETENTION_NARRATIVE_DAYS=
ROUTER_RETENTION_EVIDENCE_DAYS=
ROUTER_RETENTION_OUTBOX_DAYS=

# How long attorneys have to answer, in seconds
ROUTER_PING_OFFER_TTL_SECONDS=90
ROUTER_SHARED_OFFER_TTL_SECONDS=900

# Email. Leave as-is to use the local Mailpit test inbox (http://localhost:8025).
ROUTER_SMTP_HOST=mailpit
ROUTER_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# For a real mail provider, also set these. Quote values with spaces or < >, because
# `make demo` and the CI read this file with the shell: ROUTER_SMTP_FROM='Barrgo Leads <leads@example.com>'
ROUTER_SMTP_FROM=
ROUTER_SMTP_USERNAME=
ROUTER_SMTP_PASSWORD=
ROUTER_SMTP_STARTTLS=

# Optional tuning. Leave empty to use the defaults shown in brackets.
# JSON values go in single quotes. Distribution model per practice area ("*" = everything else):
#   ROUTER_DISTRIBUTION_POLICY='{"personal_injury":"ping_tree","family_law":"shared","*":"shared"}'
ROUTER_DISTRIBUTION_POLICY=
# Lowest price per lead in cents, in every practice area (auction or set price); also what
# the last bidder in an auction line pays. Every area needs one above 0, so keep a "*" entry,
# e.g. '{"personal_injury":5000,"*":1500}' [PI 5000, med-mal 7500, workers' comp 4000, * 1500]
ROUTER_FLOOR_PRICE_CENTS=
# Auction price: second_price = $1 above the next bid, never above your own [second_price];
# first_price = your own bid. Increment and the highest bid attorneys can enter [100, 500000]
ROUTER_AUCTION_PRICING=
ROUTER_BID_INCREMENT_CENTS=
ROUTER_MAX_BID_CENTS=
# How many times a day an attorney can save bid changes on their bid page [10]
ROUTER_MAX_BID_SAVES_PER_DAY=
# Most attorneys one inquiry is shared with, in any model; also written into the consent text [3]
ROUTER_SHARED_MAX_ATTORNEYS=
ROUTER_DUPLICATE_WINDOW_DAYS=
# Daily lead caps reset at midnight here [America/Chicago]
ROUTER_BUSINESS_TIMEZONE=
# Intake submissions allowed per IP per minute, 0 = off [10]
ROUTER_INTAKE_RATE_LIMIT_PER_MINUTE=
ROUTER_OUTBOX_MAX_ATTEMPTS=
ROUTER_OUTBOX_TIME_BUDGET_SECONDS=
ROUTER_WORKER_INTERVAL_SECONDS=
ROUTER_PLATFORM_NAME=
# Bump when the disclosure or consent wording changes [2026-10-15]
ROUTER_DISCLOSURE_VERSION=
# Proxies allowed to set X-Forwarded-For: comma-separated addresses or CIDR ranges [127.0.0.1].
# Set this when a reverse proxy sits in front of the router. Through a published Docker port
# the router sees the Docker network's gateway (e.g. 172.19.0.1), not 127.0.0.1, so use that
# address (or the network's subnet for a proxy container), pin the network so it can't change,
# and run `make up` after editing. See "Behind a reverse proxy" in docs/RUNBOOK.md.
ROUTER_TRUSTED_PROXY_IPS=

# --- eXo Platform (only used with `make up-full`) -----------------------------
EXO_PROXY_VHOST=exoapp.local
EXO_HTTP_PORT=80
# host:port browsers use to reach eXo; ONLYOFFICE builds its URLs from it. Leave empty to
# follow EXO_PROXY_VHOST and EXO_HTTP_PORT (e.g. exoapp.local:80). Set it only for another name.
EXO_PUBLIC_HOST=
EXO_JVM_SIZE_MAX=3g
EXO_DB_PASSWORD=__RANDOM__
# Send consumers' names, contact details and descriptions to eXo too [false]. Off, eXo
# gets the reference, practice area, ZIP and status, and the router stays the only copy.
ROUTER_EXO_SYNC_CONTACT_DETAILS=
EXO_DB_ROOT_PASSWORD=__RANDOM__
ONLYOFFICE_JWT_SECRET=__RANDOM__
# Set to barrgo/exo-leadcapture:local after `make exo-addon` to include the lead-capture add-on
# (the add-on must match the eXo version; see infra/exo/README.md).
EXO_IMAGE=exoplatform/exo-community:7.2.0

# --- Router -> eXo sync (optional, needs the lead-capture add-on) --------------
ROUTER_EXO_SYNC_ENABLED=false
ROUTER_EXO_LEADCAPTURE_TOKEN=
ROUTER_EXO_USERNAME=
ROUTER_EXO_PASSWORD=
