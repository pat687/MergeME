<?xml version="1.0" encoding="UTF-8"?>
<!-- Lets Maven find eXo's and Meeds' published libraries when building the add-on. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <profiles>
    <profile>
      <id>exo</id>
      <repositories>
        <repository>
          <id>exo-public</id>
          <url>https://repository.exoplatform.org/public</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>exo-public</id>
          <url>https://repository.exoplatform.org/public</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>exo</activeProfile>
  </activeProfiles>
</settings>
