# Rendered by the nginx image into /etc/nginx/conf.d/exo-server.conf at startup.
server {
  # Same port inside and outside the container: eXo and ONLYOFFICE call each other
  # through exoapp.local:<port>, which resolves to this proxy on the Docker network.
  listen ${EXO_HTTP_PORT} default_server;

  # Keep the port (e.g. exoapp.local:8080) so the links eXo builds stay correct
  # when EXO_HTTP_PORT isn't 80.
  proxy_set_header Host              $this_host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $the_scheme;
  proxy_set_header X-Forwarded-Host  $this_host;

  # ONLYOFFICE versioned static assets and websocket ("/9.4.0-123/...")
  location ~ ^(/[\d]+\.[\d]+\.[\d]+[.-][^/]+)(/.*)$ {
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://onlyoffice;
  }

  # ONLYOFFICE service endpoints
  location ~ ^/(OfficeWeb|web-apps|sdkjs|sdkjs-plugins|fonts|cache|coauthoring|downloadfile|converter|printfile|healthcheck) {
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://onlyoffice;
  }

  # eXo live updates (CometD websocket)
  location /cometd/cometd {
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://exo_app;
  }

  location / {
    proxy_pass http://exo_app;
  }
}
